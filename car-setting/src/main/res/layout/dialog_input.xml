<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog with a text field: title, message, field and two buttons. Sits high so the keyboard fits. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/panel"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/input_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/input_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_field"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/field_line"
            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/caption"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/input_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFF6B6B"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/input_cancel"
                style="@style/PillButton"
                android:text="@string/home_cancel" />

            <TextView
                android:id="@+id/input_ok"
                style="@style/PillButton"
                android:text="@string/home_ok" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
