<?xml version="1.0" encoding="utf-8"?>
<!-- Thin-line progress bar: 2dp gray track and white progress. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hairline_strong" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="2dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FFE9EBEE" />
            </shape>
        </clip>
    </item>
</layer-list>
