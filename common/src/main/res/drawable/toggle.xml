<?xml version="1.0" encoding="utf-8"?>
<!-- [ST] [LOC/DX] [AF] [TA]: border only; on = cyan border and background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2B3036" />
            <stroke android:width="1.5dp" android:color="@color/text" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/outline_strong" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
