<?xml version="1.0" encoding="utf-8"?>
<!-- Minimalist button: thin outline only, nearly square corners. Active = white outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF14171B" />
            <stroke android:width="1dp" android:color="#FF4A4F57" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FFE9EBEE" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/hairline_strong" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
