<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "O que está tocando": lê o serviço de rádio e manda memória anterior/próxima e liga/desliga,
         com as mesmas permissões do app de rádio original (ignoradas se o sistema não conceder). -->
    <uses-permission
        android:name="android.permission.ACCESS_FM_RADIO"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Para pedir ao sistema NWD que altere propriedades (Settings.System "nwd_system_prop"),
         como o launcher padrão. Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Leitura de /sdcard/nwd-configs/launcher.json (gravado pelo car-setting). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Módulos de velocidade e dados do GPS da tela inicial. Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Aviso de volume e menu da borda de baixo por cima dos outros apps (overlay/). Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Vigia da partida (start/StartReceiver): boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LauncherApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Apps com targetSdk < 26 ganham um limite de proporção de 1,86 (tela "encaixotada");
             liberamos até 2,4 para ocupar os 1280×720 inteiros. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- Tela inicial (launcher). -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gaveta: aberta pelo item Apps do dock, aqui e nos apps do suíte (com.k4811.launcher.action.APPS). -->
        <activity
            android:name=".AppsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="com.k4811.launcher.action.APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Tela de navegação: o app de navegação em tela dividida ao lado deste painel (com.k4811.launcher.action.NAV_HOME).
             Redimensionável (com targetSdk < 24 o padrão é não ser, e isso desfaria a divisão) e numa tarefa própria. -->
        <activity
            android:name=".NavHomeActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.k4811.launcher.nav"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="com.k4811.launcher.action.NAV_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Para o Android liberar a leitura dos players (Spotify, YouTube Music…) à tela de navegação,
             depois que o usuário ligar o acesso a notificações, e para "Bloquear notificações" (apaga as
             notificações assim que aparecem). Não lê o conteúdo das notificações. -->
        <service
            android:name="com.k4811.launcher.nav.MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Aviso de volume por cima dos apps. Exportado só para a prévia pelo adb (modo desenvolvedor). -->
        <service
            android:name="com.k4811.launcher.overlay.VolumeOverlayService"
            android:exported="true" />
        <!-- Menu Voltar | Vol− Vol+ | Início ao deslizar da borda de baixo. -->
        <service
            android:name="com.k4811.launcher.overlay.EdgeMenuService"
            android:exported="false" />
        <!-- Carro ligou: se um app de fábrica abrir sozinho, volta para a suíte (start/StartGuard).
             Também recebe a última tela dos outros apps da suíte (com.k4811.action.SCREEN_SHOWN). -->
        <receiver
            android:name=".start.StartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nwd.ACTION_BACKGROUND_MEDIA_PLAY" />
                <action android:name="com.nwd.action.ACTION_MCU_STATE_CHANGE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.k4811.action.SCREEN_SHOWN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
