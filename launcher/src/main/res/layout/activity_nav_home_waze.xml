<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela de navegação com o Waze embutido (o launcher é o host do modo carro do Waze modificado):
    igual à do mapa integrado, com o Waze no lugar da MapScreen. NavHomeActivity troca a ordem
    quando a música fica à direita.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_map_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal">

    <include
        layout="@layout/activity_nav_home"
        android:layout_width="500dp"
        android:layout_height="match_parent" />

    <!-- O WazeScreen (launcher/waze) entra aqui pelo código. -->
    <FrameLayout
        android:id="@+id/nav_map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"
        android:layout_marginRight="26dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />
</LinearLayout>
