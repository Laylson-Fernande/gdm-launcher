<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Radio permissions; ignored if the system doesn't grant them. -->
    <uses-permission
        android:name="android.permission.ACCESS_FM_RADIO"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- To ask the NWD system to change properties (Settings.System "nwd_system_prop").
         With targetSdk < 23 it is granted at install time. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- USB/SD track cover art (content://media/external/audio/media/ID/albumart). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- MediaPlayer with PARTIAL_WAKE_LOCK while playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Export the props (developer menu) to Download/. With targetSdk < 23 it is granted at install time. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Home speed and GPS data modules. With targetSdk < 23 it is granted at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".GaragemApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Apps with targetSdk < 26 get a 1.86 aspect ratio limit ("letterboxed" screen);
             we allow up to 2.4 to fill the whole 1280×720. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- Home screen (launcher). nosensor = the head unit's own orientation: landscape units or
             768×1024 portrait ones (the home grid turns its columns into rows). Settings screens
             too, the radio and MP3; the other screens are still designed for landscape only. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Radio: opened by the "Rádio" button on the home screen. nosensor: layout-port has a
             one-column version for portrait head units. -->
        <activity
            android:name=".RadioActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Drawer: opened by the dock's Apps item. -->
        <activity
            android:name=".AppsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <!-- USB/SD music: our own player. nosensor: layout-port puts the song on top and the list
             below on portrait head units. -->
        <activity
            android:name=".MusicActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Bluetooth music: phone track via A2DP. -->
        <activity
            android:name=".BtMusicActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <!-- Fan: preferences in Settings.System. -->
        <activity
            android:name=".FanActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <!-- Bluetooth phone: dialing, contacts, history and call. -->
        <activity
            android:name=".PhoneActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <!-- Equalizer: MCU / ARM DSP. -->
        <activity
            android:name=".EqActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <!-- Launcher settings (gear on the home screen). -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Home screen modules (Settings › Customize › Customize home screen). -->
        <activity
            android:name=".HomeSettingsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Dock icons (Settings › Customize › Customize dock). -->
        <activity
            android:name=".DockSettingsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Advanced (Settings, password-protected): factory, development and NWD menus. -->
        <activity
            android:name=".AdvancedActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- System props (inside Advanced). -->
        <activity
            android:name=".DevPropsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <service
            android:name=".music.MusicPlaybackService"
            android:exported="false" />
    </application>
</manifest>
