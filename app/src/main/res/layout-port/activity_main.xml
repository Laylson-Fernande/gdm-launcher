<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait version (768×1024 head units): one column, same ids as layout/activity_main.xml.
     Top to bottom: bands, status, station, RadioText, reception functions, dial, tuning controls
     and, at the bottom, the memories in a single row that scrolls sideways. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Band tabs + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.garagemdomadeira.nwd.launcher.ui.SlantedTabsView
                android:id="@+id/tabs"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />


            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_exit"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:layout_marginLeft="12dp"
                android:contentDescription="@string/radio_cd_exit" />
        </LinearLayout>


        <!-- Station art (Garagem/radio/FM_104.5.jpg, placeholder without it) + frequency and name, left-aligned. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left|center_vertical"
            android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/station_art_frame"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginRight="32dp"
            android:background="@drawable/art_frame">

            <!-- Placeholder while there is no Garagem/radio/<FM|AM>_<freq>.jpg -->
            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/station_art_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />

            <ImageView
                android:id="@+id/station_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/radio_cd_station_art"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:orientation="vertical">

        <!-- Frequency -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:baselineAligned="true"
            android:gravity="left"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/freq_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="98.5"
                android:textColor="@color/text"
                android:textSize="84sp" />

            <TextView
                android:id="@+id/freq_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:includeFontPadding="false"
                android:text="MHz"
                android:textColor="@color/text_muted"
                android:textSize="40sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:ellipsize="end"
            android:gravity="left"
            android:includeFontPadding="false"
            android:maxWidth="620dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="42sp" />
        </LinearLayout>
        </LinearLayout>

        <!-- Scrolling RadioText -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:gravity="left|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="0dp"
            android:paddingRight="40dp">

            <TextView
                android:id="@+id/rt_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="«"
                android:textColor="@color/text_dim"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/radio_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_weight="0"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxWidth="600dp"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/rt_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="»"
                android:textColor="@color/text_dim"
                android:textSize="26sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Reception functions + keypad, right above the dial -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/toggle_st" style="@style/ToggleBox">
                    <com.garagemdomadeira.nwd.launcher.ui.IconView
                        android:id="@+id/toggle_st_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />
                    <TextView android:id="@+id/toggle_st_text" style="@style/ToggleBoxText" />
                    <View
                        android:id="@+id/toggle_st_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="14dp"
                        android:background="@drawable/status_dot" />
                </LinearLayout>
                <LinearLayout android:id="@+id/toggle_loc" style="@style/ToggleBox">
                    <com.garagemdomadeira.nwd.launcher.ui.IconView
                        android:id="@+id/toggle_loc_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />
                    <TextView android:id="@+id/toggle_loc_text" style="@style/ToggleBoxText" />
                    <View
                        android:id="@+id/toggle_loc_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="14dp"
                        android:background="@drawable/status_dot" />
                </LinearLayout>
            </LinearLayout>

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_keypad"
                android:layout_width="80dp"
                android:layout_height="56dp"
                android:layout_gravity="right|center_vertical"
                android:contentDescription="@string/radio_cd_keypad" />
        </FrameLayout>

        <com.garagemdomadeira.nwd.launcher.ui.TunerDialView
            android:id="@+id/dial"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <!-- Tuning controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_seek_prev"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/radio_cd_prev_saved" />

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_step_prev"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginLeft="20dp"
                android:contentDescription="@string/radio_cd_step_down" />

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_power"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                android:contentDescription="@string/radio_cd_power" />

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_step_next"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginRight="20dp"
                android:contentDescription="@string/radio_cd_step_up" />

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/btn_seek_next"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/radio_cd_next_saved" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ===================== Presets: one row at the bottom ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/presets_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="@string/radio_favorites"
                    android:textColor="@color/text"
                    android:textSize="28sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/presets_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fadingEdgeLength="24dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

                <!-- Horizontal: RadioActivity builds the 12 memories in a single row. -->
                <LinearLayout
                    android:id="@+id/presets_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/radio_presets_hint"
                android:textColor="@color/text_dim"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Connection warning -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/pill"
        android:paddingBottom="12dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:textSize="22sp"
        android:visibility="gone" />
</FrameLayout>
