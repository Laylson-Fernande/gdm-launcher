<?xml version="1.0" encoding="utf-8"?>
<!-- Generic dialog: title, message, highlighted text (optional) and two buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/confirm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/confirm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_muted"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/confirm_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/log_bg"
            android:padding="14dp"
            android:textColor="@color/accent"
            android:textIsSelectable="true"
            android:textSize="18sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/confirm_negative"
                style="@style/PillButton" />

            <TextView
                android:id="@+id/confirm_positive"
                style="@style/PillButton" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
