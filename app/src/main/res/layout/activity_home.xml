<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen: content area 1280×560 (the dock is attached at the bottom by Screens.attachDock).
    Now playing, with cover (left) · clock and, below it, volume (− mute +) (center)
    · fan and Bluetooth (right)
    · screen off and settings (top-right corner).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Free area: holding ~1 s opens Android Settings (emergency exit). -->
    <View
        android:id="@+id/home_space"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===== Screen off and settings ===== -->
    <com.garagemdomadeira.nwd.launcher.ui.IconView
        android:id="@+id/screen_off_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|right"
        android:layout_marginRight="104dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/home_screen_off" />

    <com.garagemdomadeira.nwd.launcher.ui.IconView
        android:id="@+id/settings_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|right"
        android:layout_marginRight="22dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/home_settings" />

    <!-- ===== Clock (center) ===== -->
    <LinearLayout
        android:id="@+id/clock_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="96dp"
        android:clickable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="00:00"
            android:textColor="@color/text"
            android:textSize="158sp" />

        <TextView
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:textColor="@color/text_soft"
            android:textSize="30sp" />
    </LinearLayout>

    <!-- ===== Battery voltage (CAN): only shown if the head unit responds ===== -->
    <LinearLayout
        android:id="@+id/voltage"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/home_battery_voltage"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/voltage_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/voltage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:includeFontPadding="false"
            android:textColor="@color/text"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- ===== Volume: − mute +, centered below the clock ===== -->
    <LinearLayout
        android:id="@+id/volume_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="384dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/volume_down"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/home_volume_down" />

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/volume_mute"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginLeft="44dp"
            android:layout_marginRight="44dp"
            android:contentDescription="@string/home_mute" />

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/volume_up"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/home_volume_up" />
    </LinearLayout>

    <!-- ===== Now playing (left) ===== -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="76dp"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Album cover (MP3) or source icon (radio, Bluetooth). -->
        <FrameLayout
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/art_frame"
            android:padding="1dp">

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/np_art_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false"
                android:padding="72dp" />

            <ImageView
                android:id="@+id/np_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/home_cover"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/np_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.28"
            android:singleLine="true"
            android:text="@string/home_now_playing"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/np_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/np_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="24sp"
            android:visibility="gone" />

        <!-- Thin progress bar -->
        <FrameLayout
            android:id="@+id/np_progress_track"
            android:layout_width="150dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/progress_track">

            <View
                android:id="@+id/np_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/progress_fill"
                android:scaleX="0"
                android:transformPivotX="0px" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/np_controls"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginLeft="-10dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/np_prev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/home_previous" />

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/np_play"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:contentDescription="@string/home_play_pause" />

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/np_next"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/home_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Call (on top of "now playing") ===== -->
    <LinearLayout
        android:id="@+id/card_call"
        android:layout_width="420dp"
        android:layout_height="220dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="300dp"
        android:background="@drawable/panel"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/call_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:textColor="@color/text_muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/call_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_answer"
                style="@style/PillButton"
                android:layout_height="60dp"
                android:text="@string/home_answer"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/call_hangup"
                style="@style/PillButton"
                android:layout_height="60dp"
                android:text="@string/home_hang_up"
                android:textColor="#FFFF6B6B"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Right column: fan | Bluetooth ===== -->
    <View
        android:layout_width="1dp"
        android:layout_height="270dp"
        android:layout_marginLeft="955dp"
        android:layout_marginTop="178dp"
        android:background="@color/hairline" />

    <LinearLayout
        android:id="@+id/fan_status"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="986dp"
        android:layout_marginTop="174dp"
        android:clickable="true"
        android:contentDescription="@string/home_fan"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/fan_status_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fan_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/home_fan_caps"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/fan_status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/fan_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:includeFontPadding="false"
                    android:text="@string/home_fan_off"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="225dp"
        android:layout_height="1dp"
        android:layout_marginLeft="1000dp"
        android:layout_marginTop="298dp"
        android:background="@color/hairline" />

    <LinearLayout
        android:id="@+id/bt_status"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="986dp"
        android:layout_marginTop="342dp"
        android:clickable="true"
        android:contentDescription="@string/home_bluetooth"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/bt_status_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="false"
            android:duplicateParentState="true"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bt_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/home_bt_disconnected"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/bt_status_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxWidth="210dp"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Screen off: black layer over everything; any touch turns the backlight back on. -->
    <View
        android:id="@+id/screen_off_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:contentDescription="@string/home_tap_to_wake"
        android:visibility="gone" />
</FrameLayout>
