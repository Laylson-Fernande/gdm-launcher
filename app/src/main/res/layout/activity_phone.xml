<?xml version="1.0" encoding="utf-8"?>
<!--
    Bluetooth phone, minimalist: text tabs with a stroke, thin lines dividing the areas
    and a geometric grid keypad. Content area 1280×560 (the dock is attached at the bottom).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.garagemdomadeira.nwd.launcher.ui.IconView
                android:id="@+id/phone_back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/media_back" />

            <TextView
                android:id="@+id/phone_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="@string/media_phone_title"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/phone_status"
                style="@style/Caption"
                android:text="Bluetooth" />
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/phone_tabs"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_dial"
                style="@style/LineTab"
                android:text="@string/media_phone_tab_dial" />

            <TextView
                android:id="@+id/tab_contacts"
                style="@style/LineTab"
                android:text="@string/media_phone_tab_contacts" />

            <TextView
                android:id="@+id/tab_logs"
                style="@style/LineTab"
                android:text="@string/media_phone_tab_logs" />

            <TextView
                android:id="@+id/tab_settings"
                style="@style/LineTab"
                android:text="@string/media_phone_tab_settings" />
        </LinearLayout>

        <View
            style="@style/HairlineH"
            android:layout_marginLeft="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="8dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- ===== Dialing: number | grid keypad ===== -->
            <LinearLayout
                android:id="@+id/panel_dial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="420dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="48dp">

                    <TextView
                        style="@style/Caption"
                        android:text="@string/media_phone_number_caption" />

                    <TextView
                        android:id="@+id/dial_number"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="6dp"
                        android:ellipsize="start"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="38sp" />

                    <View style="@style/HairlineH" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dial_backspace"
                            style="@style/LineButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginLeft="0dp"
                            android:layout_weight="1"
                            android:text="@string/media_phone_delete" />

                        <TextView
                            android:id="@+id/dial_call"
                            style="@style/LineButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginLeft="12dp"
                            android:layout_weight="1"
                            android:text="@string/media_phone_call" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="260dp"
                    android:background="@color/hairline" />

                <LinearLayout
                    android:layout_width="372dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="48dp"
                    android:background="@drawable/grid_frame"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/key_1"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_2"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_3"
                            layout="@layout/phone_key" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/key_4"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_5"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_6"
                            layout="@layout/phone_key" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/key_7"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_8"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_9"
                            layout="@layout/phone_key" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/key_star"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_0"
                            layout="@layout/phone_key" />

                        <include
                            android:id="@+id/key_hash"
                            layout="@layout/phone_key" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Contacts ===== -->
            <LinearLayout
                android:id="@+id/panel_contacts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/contacts_hint"
                        style="@style/Caption"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/media_phone_tap_to_call" />

                    <TextView
                        android:id="@+id/contacts_sync"
                        style="@style/LineButton"
                        android:text="@string/media_phone_sync" />
                </LinearLayout>

                <View
                    style="@style/HairlineH"
                    android:layout_marginTop="12dp" />

                <ListView
                    android:id="@+id/contacts_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@color/hairline"
                    android:dividerHeight="1dp"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ===== Calls ===== -->
            <LinearLayout
                android:id="@+id/panel_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/logs_missed"
                        style="@style/LineButton"
                        android:layout_marginLeft="0dp"
                        android:text="@string/media_phone_logs_missed" />

                    <TextView
                        android:id="@+id/logs_received"
                        style="@style/LineButton"
                        android:text="@string/media_phone_logs_received" />

                    <TextView
                        android:id="@+id/logs_dialed"
                        style="@style/LineButton"
                        android:text="@string/media_phone_logs_dialed" />
                </LinearLayout>

                <View
                    style="@style/HairlineH"
                    android:layout_marginTop="14dp" />

                <ListView
                    android:id="@+id/logs_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@color/hairline"
                    android:dividerHeight="1dp"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ===== Settings ===== -->
            <ScrollView
                android:id="@+id/panel_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Device -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingRight="40dp">

                        <TextView
                            style="@style/Caption"
                            android:text="@string/media_phone_bt_name" />

                        <EditText
                            android:id="@+id/settings_name"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/field_line"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/Caption"
                            android:layout_marginTop="22dp"
                            android:text="PIN" />

                        <EditText
                            android:id="@+id/settings_pin"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/field_line"
                            android:inputType="numberPassword"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/settings_save"
                            style="@style/LineButton"
                            android:layout_height="52dp"
                            android:layout_marginLeft="0dp"
                            android:layout_marginTop="26dp"
                            android:paddingLeft="32dp"
                            android:paddingRight="32dp"
                            android:text="@string/media_phone_save" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/hairline" />

                    <!-- Automations -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingLeft="40dp">

                        <TextView
                            style="@style/Caption"
                            android:text="@string/media_phone_automatic" />

                        <TextView
                            android:id="@+id/settings_auto_answer"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@drawable/list_row"
                            android:gravity="center_vertical"
                            android:paddingLeft="16dp"
                            android:text="@string/media_phone_auto_answer_off"
                            android:textColor="@color/line_text"
                            android:textSize="20sp" />

                        <View style="@style/HairlineH" />

                        <TextView
                            android:id="@+id/settings_auto_connect"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@drawable/list_row"
                            android:gravity="center_vertical"
                            android:paddingLeft="16dp"
                            android:text="@string/media_phone_auto_connect_off"
                            android:textColor="@color/line_text"
                            android:textSize="20sp" />

                        <View style="@style/HairlineH" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Call (covers the screen) ===== -->
    <LinearLayout
        android:id="@+id/call_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA050608"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/call_state"
            style="@style/Caption"
            android:text="@string/media_phone_call_caption" />

        <TextView
            android:id="@+id/call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:maxWidth="900dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/call_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted"
            android:textSize="24sp" />

        <View
            android:layout_width="96dp"
            android:layout_height="1dp"
            android:layout_marginTop="30dp"
            android:background="@color/hairline_strong" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_answer"
                style="@style/LineButton"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="16dp"
                android:text="@string/media_phone_answer" />

            <TextView
                android:id="@+id/call_hangup"
                style="@style/LineButton"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_marginLeft="0dp"
                android:text="@string/media_phone_hang_up"
                android:textColor="#FFFF6B6B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_mute"
                style="@style/LineButton"
                android:layout_width="140dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="16dp"
                android:text="@string/media_phone_mute" />

            <TextView
                android:id="@+id/call_channel"
                style="@style/LineButton"
                android:layout_width="140dp"
                android:layout_marginLeft="0dp"
                android:text="@string/media_phone_audio" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
