<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer: 5×2 grid per page, at 1280×720. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="28dp">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/apps_back"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/home_apps_back" />

        <TextView
            android:id="@+id/apps_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="@string/home_apps_title"
            android:textColor="@color/text"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/apps_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <LinearLayout
                android:id="@+id/apps_row_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/apps_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/apps_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/home_apps_empty"
            android:textColor="@color/text_muted"
            android:textSize="32sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/apps_prev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/home_apps_prev_page" />

        <LinearLayout
            android:id="@+id/apps_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/apps_next"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/home_apps_next_page" />
    </LinearLayout>
</LinearLayout>
